{
  "name": "ProjectStage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Proyecto"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Orden"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo de Etapa"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de Inicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de T\u00e9rmino"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "title": "Avance (%)"
    }
  },
  "required": [
    "project_id",
    "title",
    "order"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}