  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "icon": {
      "type": "string",
      "title": "Icono (lucide-react)"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Orden"
    }
