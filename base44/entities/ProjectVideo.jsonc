{
  "name": "ProjectVideo",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Proyecto"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "title": "URL del Video"
    },
    "type": {
      "type": "string",
      "enum": [
        "timelapse",
        "progress",
        "final",
        "tour"
      ],
      "default": "progress",
      "title": "Tipo"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Orden"
    }
  },
  "required": [
    "project_id",
    "title",
    "url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}