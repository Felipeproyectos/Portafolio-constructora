{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "role": {
      "type": "string",
      "title": "Cargo"
    },
    "photo_url": {
      "type": "string",
      "format": "uri",
      "title": "Foto"
    },
    "bio": {
      "type": "string",
      "title": "Biograf\u00eda"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Orden"
    }
  },
  "required": [
    "name",
    "role"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}